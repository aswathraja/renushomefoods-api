{
	"name": "renushomefoods-api",
	"private": true,
	"version": "1.0.0",
	"description": "API Services for the Renus Home Foods Website built with NestJS",
	"license": "MIT",
	"website": "https://renushomefoods.com",
	"author": "Aswath Raja",
	"email": "aswathraja@gamil.com",
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check . --ignore-unknown",
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint . --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json"
	},
	"engines": {
		"npm": ">=10.0.0",
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@google/genai": "^2.23.0",
		"@moonshot-ai/kimi-agent-sdk": "^0.1.8",
		"@nestjs/common": "^12.0.3",
		"@nestjs/core": "^12.0.3",
		"@nestjs/platform-express": "^12.0.3",
		"axios": "^1.20.0",
		"compression": "^1.8.2",
		"crypto-es": "^3.1.3",
		"dotenv": "^18.0.1",
		"exceljs": "^4.4.0",
		"handlebars": "^4.7.9",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.12.1",
		"mysql2": "^3.24.4",
		"nodemailer": "^10.0.10",
		"openai": "^7.19.0",
		"puppeteer": "^25.11.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"sequelize": "^6.37.8",
		"sharp": "^0.35.4",
		"winston": "^3.19.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@nestjs/cli": "^12.0.3",
		"@nestjs/schematics": "^12.0.3",
		"@nestjs/testing": "^12.0.3",
		"@secretlint/secretlint-rule-aws": "^13.0.5",
		"@secretlint/secretlint-rule-basicauth": "^13.0.5",
		"@secretlint/secretlint-rule-no-dotenv": "^13.0.5",
		"@secretlint/secretlint-rule-npm": "^13.0.5",
		"@secretlint/secretlint-rule-privatekey": "^13.0.5",
		"@secretlint/secretlint-rule-slack": "^13.0.5",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.16.2",
		"@types/compression": "^1.8.1",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.6.2",
		"@types/supertest": "^7.2.1",
		"ajv": "^8.20.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.5.1",
		"prettier": "^3.9.8",
		"secretlint": "^13.0.5",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.12",
