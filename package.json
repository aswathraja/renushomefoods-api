		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.3",
		"secretlint": "^13.0.2",
